{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyph Vault Policy Bundle",
  "type": "object",
  "required": ["version", "roles"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "roles": {
      "type": "object",
      "required": ["service", "operator", "break-glass"],
      "properties": {
        "service": {"type": "array", "items": {"type": "string"}},
        "operator": {"type": "array", "items": {"type": "string"}},
        "break-glass": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
