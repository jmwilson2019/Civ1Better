{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyph Vault Secret Envelope",
  "type": "object",
  "required": ["secret_id", "version", "created_at", "owner", "policy", "signer_fingerprint", "ciphertext_b64", "sha256"],
  "properties": {
    "secret_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "owner": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "minLength": 1},
    "signer_fingerprint": {"type": "string", "minLength": 1},
    "ciphertext_b64": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
